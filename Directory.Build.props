<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Resources.Extensions">
      <HintPath>$(MSBuildThisFileDirectory)LaserIOUI\System.Resources.Extensions.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
</Project>
